    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "hbar = 1\n",
    "m = 1\n",
    "l = 0\n",
    "\n",
    "N = 400                      # Number of grid points\n",
    "r = np.linspace(0.1, 10, N) # Radial distance r from 0.01 to 10\n",
    "h = r[1] - r[0]              # Step size\n",
    "\n",
    "# Effective Potential\n",
    "V_eff = -1 / r + (hbar**2 * l * (l + 1)) / (2 * m * r**2) \n",
    "\n",
    "# H Matrix (H = Kinetic + Potential)\n",
    "main_diag = -2 * np.ones(N)\n",
    "off_diag = np.ones(N - 1)\n",
    "\n",
    "K = (-hbar**2 / (2 * m * h**2)) * (np.diag(main_diag) + np.diag(off_diag, 1) + np.diag(off_diag, -1)) \n",
    "H = K + np.diag(V_eff)\n",
    "print(H)\n",
    "\n",
    "energies, wavefunctions = np.linalg.eigh(H) # Solving for energies (E) and Wavefunctions (u)\n",
    "\n",
    "fig1, ax1 = plt.subplots(figsize=(8, 5))  \n",
    "\n",
    "# Figure 2: For the R(r) wavefunctions\n",
    "fig2, ax2 = plt.subplots(figsize=(8, 5))  \n",
    "\n",
    "\n",
    "for n in range(0,1):\n",
    "    E = energies[n]\n",
    "    u = -wavefunctions[:, n] \n",
    "    R = u / r\n",
    "    print(f\"State n={n+1}: Energy E = {E:.4f}\")\n",
    "    \n",
    "    ax1.plot(r, u, label=f\"n={n+1}, E={E:.3f}\")\n",
    "    \n",
    "    ax2.plot(r, R, label=f\"n={n+1}, E={E:.3f}\")\n",
    "\n",
    "\n",
    "ax1.axhline(0, color='black', linestyle='--')\n",
    "ax1.set_title(\"Bound States of Schrödinger Equation: u(r)\")\n",
    "ax1.set_xlabel(\"Radius (r)\")\n",
    "ax1.set_ylabel(\"u(r)\")\n",
    "ax1.legend()\n",
    "ax1.grid(True)\n",
    "\n",
    "ax2.axhline(0, color='black', linestyle='--')\n",
    "ax2.set_title(\"Radial Wavefunctions: R(r) = u(r)/r\")\n",
    "ax2.set_xlabel(\"Radius (r)\")\n",
    "ax2.set_ylabel(\"R(r)\")\n",
    "ax2.legend()\n",
    "ax2.grid(True)\n",
    "\n",
    "plt.show()\n"
   ]
  },
